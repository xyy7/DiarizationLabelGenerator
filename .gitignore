# DiariZen 上游仓库：由 diarizen-config/setup.ps1 自动 clone，不入库
DiariZen/

# 依赖与构建产物
node_modules/
dist/
build/

# 模型权重（约 291 MB，由 download_models.py 下载）
models/

# 推理输出
*.rttm
# ……但 golden 测试 fixture 必须入库，否则测试套件跑不起来
!server/tests/data/*.rttm

# 运行时数据与备份。必须写成 /data/ 只匹配根目录：写 data/ 会连
# server/tests/data/ 一起排除，而被排除目录里的文件无法用 ! 重新纳入，
# golden fixture 会静默丢失、测试套件跑不起来。
backups/
/data/

# 任务记录与手工测试样例（全局规范：均不入版本控制）。
# 同样必须根锚定：写 tasks/、tests/ 会连 server/tests/ 一起排除。
/tasks/
/tests/

# 环境
.env
.venv/
venv/

# Python
__pycache__/
*.py[cod]

# 编辑器
.vscode/
.idea/
.trae/
.DS_Store

# Claude Code 本地设置（机器相关，不入库）
.claude/settings.local.json

# 远程部署辅助脚本（内含 SSH 密码，绝不入库）
/scripts/remote_ssh.py

# VSCode Counter 的统计报告
.VSCodeCounter/
